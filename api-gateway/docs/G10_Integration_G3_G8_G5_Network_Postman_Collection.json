              { "key": "X-Correlation-Id", "value": "net-g3-register" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"ROLE_PASSENGER\",\n  \"profile\": {\n    \"firstName\": \"Network\",\n    \"lastName\": \"Integration\",\n    \"phone\": \"+212600000099\",\n    \"address\": \"Casablanca\",\n    \"birthDate\": \"2000-01-01\"\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "01.2 - 200 login G3 via G10 genere JWT",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login success', function () { pm.response.to.have.status(200); });",
            "pm.test('Token captured', function () { const json = pm.response.json(); pm.expect(json.token).to.be.a('string'); pm.collectionVariables.set('createdUserToken', json.token); if (json.refreshToken) pm.collectionVariables.set('createdUserRefreshToken', json.refreshToken); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "net-g3-login" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
