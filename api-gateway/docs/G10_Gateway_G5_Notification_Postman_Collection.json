{
  "info": {
    "name": "SGITU - G10 Gateway x G5 Notifications",
    "description": "Collection Postman complete pour verifier la relation Client -> G10 -> G5 Notifications. Elle couvre health public, JWT, RBAC admin, envoi notification LOG, consultation, retry, filtres admin, erreurs 400/401/403 et resilience 503.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const secret = pm.collectionVariables.get('jwtSecret') || 'SGITU_G3_JWT_SECRET_KEY_CHANGE_ME_IN_PRODUCTION_256BITS!!';",
          "function b64url(input) {",
          "  return CryptoJS.enc.Base64.stringify(input).replace(/=+$/,'').replace(/\\+/g,'-').replace(/\\//g,'_');",
          "}",
          "function makeJwt(email, userId, roles, ttlSeconds) {",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const payload = { sub: email, userId: String(userId), roles: roles, iat: now, exp: now + ttlSeconds, jti: 'g5-postman-' + Math.random().toString(36).slice(2) };",
          "  const encodedHeader = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "  const encodedPayload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "  const signature = b64url(CryptoJS.HmacSHA256(encodedHeader + '.' + encodedPayload, secret));",
          "  return encodedHeader + '.' + encodedPayload + '.' + signature;",
          "}",
          "if (pm.collectionVariables.get('autoGenerateTokens') !== 'false') {",
          "  pm.collectionVariables.set('adminToken', makeJwt('admin.g10@sgitu.ma', '1', ['ROLE_ADMIN'], 3600));",
          "  pm.collectionVariables.set('passengerToken', makeJwt('passenger.g5@sgitu.ma', '501', ['ROLE_PASSENGER'], 3600));",
          "  pm.collectionVariables.set('operatorToken', makeJwt('operator.g5@sgitu.ma', '502', ['ROLE_OPERATOR'], 3600));",
          "  pm.collectionVariables.set('staffToken', makeJwt('staff.g5@sgitu.ma', '503', ['ROLE_STAFF'], 3600));",
          "  pm.collectionVariables.set('expiredToken', makeJwt('expired.g5@sgitu.ma', '599', ['ROLE_ADMIN'], -60));",
          "  pm.collectionVariables.set('invalidToken', pm.collectionVariables.get('adminToken') + 'invalid');",
          "}",
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', Date.now().toString());",
          "}",
          "pm.collectionVariables.set('g5NotificationId', 'g10-g5-' + pm.collectionVariables.get('runId'));"
        ]
      }
    }
  ],
  "variable": [
