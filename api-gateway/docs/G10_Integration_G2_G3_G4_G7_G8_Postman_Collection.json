{
  "info": {
    "name": "SGITU - G10 Integration G2 G3 G4 G7 G8",
    "description": "Collection globale pour tester les integrations Client -> G10 -> G2/G3/G4/G7/G8. Elle couvre JWT, RBAC, routage, correlationId, monitoring et resilience.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.collectionVariables.set('today', now.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('isoNow', now.toISOString());",
          "if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', String(Date.now())); }",
          "pm.collectionVariables.set('testEmail', 'postman.g10.' + pm.collectionVariables.get('runId') + '@sgitu.ma');",
          "",
          "if (pm.collectionVariables.get('autoGenerateTokens') !== 'true') { return; }",
          "if (typeof CryptoJS === 'undefined') { throw new Error('CryptoJS indisponible dans Postman.'); }",
          "",
          "const secret = pm.collectionVariables.get('jwtSecret');",
          "function b64url(input) {",
          "  return CryptoJS.enc.Base64.stringify(input).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "function makeJwt(email, userId, roles, ttlSeconds) {",
          "  const nowSec = Math.floor(Date.now() / 1000);",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const payload = { sub: email, userId: String(userId), roles: roles, iat: nowSec, exp: nowSec + ttlSeconds, jti: 'g10-int-' + Math.random().toString(36).slice(2) };",
          "  const unsigned = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header))) + '.' + b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "  const signature = b64url(CryptoJS.HmacSHA256(unsigned, secret));",
          "  return unsigned + '.' + signature;",
          "}",
          "",
          "pm.collectionVariables.set('adminToken', makeJwt('admin.g10@sgitu.ma', '1', ['ROLE_ADMIN'], 3600));",
          "pm.collectionVariables.set('passengerToken', makeJwt('passenger.g10@sgitu.ma', '2', ['ROLE_PASSENGER'], 3600));",
          "pm.collectionVariables.set('operatorToken', makeJwt('operator.g10@sgitu.ma', '3', ['ROLE_OPERATOR'], 3600));",
          "pm.collectionVariables.set('staffToken', makeJwt('staff.g10@sgitu.ma', '4', ['ROLE_STAFF'], 3600));",
          "pm.collectionVariables.set('adminG2Token', makeJwt('admin.g2@sgitu.ma', '202', ['ROLE_ADMIN_G2'], 3600));",
          "pm.collectionVariables.set('g4OperatorToken', makeJwt('operator.g4@sgitu.ma', '401', ['ROLE_G4_OPERATOR'], 3600));",
          "pm.collectionVariables.set('dispatcherToken', makeJwt('dispatcher.g4@sgitu.ma', '402', ['ROLE_DISPATCHER'], 3600));",
          "pm.collectionVariables.set('g4AdminToken', makeJwt('admin.g4@sgitu.ma', '403', ['ROLE_G4_ADMIN'], 3600));",
          "pm.collectionVariables.set('adminG7Token', makeJwt('admin.g7@sgitu.ma', '705', ['ROLE_ADMIN_G7'], 3600));",
          "pm.collectionVariables.set('driverToken', makeJwt('driver.g7@sgitu.ma', '704', ['ROLE_DRIVER'], 3600));",
          "pm.collectionVariables.set('technicianToken', makeJwt('technician.g7@sgitu.ma', '703', ['ROLE_TECHNICIAN'], 3600));",
          "pm.collectionVariables.set('expiredToken', makeJwt('expired.g10@sgitu.ma', '9', ['ROLE_ADMIN'], -60));",
          "pm.collectionVariables.set('invalidToken', 'invalid.jwt.token');",
          "pm.collectionVariables.set('planName', 'Plan G10 Integration ' + pm.collectionVariables.get('runId'));",
          "pm.collectionVariables.set('lineCode', 'G10-G4-' + pm.collectionVariables.get('runId'));",
          "pm.collectionVariables.set('vehiclePlate', 'BUS-G10-G7-' + pm.collectionVariables.get('runId'));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "prometheusUrl", "value": "http://localhost:9090" },
    { "key": "grafanaUrl", "value": "http://localhost:3000" },
    { "key": "jwtSecret", "value": "SGITU_G3_JWT_SECRET_KEY_CHANGE_ME_IN_PRODUCTION_256BITS!!" },
    { "key": "autoGenerateTokens", "value": "true" },
    { "key": "runId", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "createdUserId", "value": "1" },
    { "key": "createdUserToken", "value": "" },
    { "key": "g2PlanId", "value": "1" },
    { "key": "g2SubscriptionId", "value": "1" },
    { "key": "g4LineId", "value": "1" },
    { "key": "g4MissionId", "value": "1" },
    { "key": "g7VehicleId", "value": "53c31262-591a-44d4-8872-51e84611ac5e" },
    { "key": "g7AlertId", "value": "36b01ab6-31f8-47cb-82f4-5ffad4a90b95" },
    { "key": "reportId", "value": "" }
  ],
