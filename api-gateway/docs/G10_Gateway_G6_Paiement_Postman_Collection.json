{
  "info": {
    "name": "SGITU - G10 Gateway x G6 Paiement",
    "description": "Collection Postman complete pour verifier la relation Client -> G10 -> G6 Paiement. Elle couvre health public, JWT, routage, comptes de paiement, transactions, factures, remboursements, erreurs 400/401 et resilience 503.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const secret = pm.collectionVariables.get('jwtSecret') || 'SGITU_G3_JWT_SECRET_KEY_CHANGE_ME_IN_PRODUCTION_256BITS!!';",
          "function b64url(input) { return CryptoJS.enc.Base64.stringify(input).replace(/=+$/,'').replace(/\\+/g,'-').replace(/\\//g,'_'); }",
          "function makeJwt(email, userId, roles, ttlSeconds) {",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const payload = { sub: email, userId: String(userId), roles: roles, iat: now, exp: now + ttlSeconds, jti: 'g6-postman-' + Math.random().toString(36).slice(2) };",
          "  const h = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "  const p = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "  const s = b64url(CryptoJS.HmacSHA256(h + '.' + p, secret));",
          "  return h + '.' + p + '.' + s;",
          "}",
          "if (pm.collectionVariables.get('autoGenerateTokens') !== 'false') {",
          "  pm.collectionVariables.set('passengerToken', makeJwt('passenger.g6@sgitu.ma', '6', ['ROLE_PASSENGER'], 3600));",
          "  pm.collectionVariables.set('adminToken', makeJwt('admin.g10@sgitu.ma', '1', ['ROLE_ADMIN'], 3600));",
          "  pm.collectionVariables.set('expiredToken', makeJwt('expired.g6@sgitu.ma', '99', ['ROLE_PASSENGER'], -60));",
          "  pm.collectionVariables.set('invalidToken', pm.collectionVariables.get('passengerToken') + 'invalid');",
          "}",
          "if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', Date.now().toString()); }",
          "pm.collectionVariables.set('sourceId', pm.collectionVariables.get('runId').slice(-6));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "g6DirectUrl", "value": "http://localhost:8086", "type": "string" },
    { "key": "jwtSecret", "value": "SGITU_G3_JWT_SECRET_KEY_CHANGE_ME_IN_PRODUCTION_256BITS!!", "type": "string" },
    { "key": "autoGenerateTokens", "value": "true", "type": "string" },
    { "key": "passengerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "expiredToken", "value": "", "type": "string" },
    { "key": "invalidToken", "value": "", "type": "string" },
    { "key": "runId", "value": "", "type": "string" },
    { "key": "sourceId", "value": "1001", "type": "string" },
    { "key": "paymentId", "value": "1", "type": "string" },
    { "key": "refundId", "value": "1", "type": "string" },
    { "key": "paymentAccountId", "value": "1", "type": "string" }
  ],
