{
  "info": {
    "_postman_id": "g10-g3-g8-integration-collection",
    "name": "SGITU - Integration G10 + G3 + G8 - Tests complets",
    "description": "Collection Postman complete pour valider le flux Client -> G10 Gateway -> G3 Utilisateurs/JWT et Client -> G10 Gateway -> G8 Analytics/ML. Elle couvre preconditions, creation utilisateur, login G3, validation JWT par G10, RBAC, endpoints utilisateurs G3, ingestion G8, analytics G8, ML G8 et cas d'erreur 400/401/403/404/409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.collectionVariables.set('isoNow', now.toISOString());",
          "pm.collectionVariables.set('today', now.toISOString().slice(0, 10));",
          "if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', 'int-' + Date.now()); }",
          "pm.collectionVariables.set('testEmail', 'integration.' + pm.collectionVariables.get('runId') + '@sgitu.ma');",
          "",
          "const autoGenerate = String(pm.collectionVariables.get('autoGenerateTokens') || 'true').toLowerCase() === 'true';",
          "if (autoGenerate) {",
          "  if (typeof CryptoJS === 'undefined') { throw new Error('CryptoJS indisponible: mettre autoGenerateTokens=false et coller des JWT G3.'); }",
          "  const secret = pm.collectionVariables.get('jwtSecret');",
          "  const nowSec = Math.floor(Date.now() / 1000);",
          "  function base64Url(wordArray) { return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_'); }",
          "  function encodeObject(obj) { return base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj))); }",
          "  function makeJwt(email, userId, roles, ttlSeconds) {",
          "    const header = { alg: 'HS256', typ: 'JWT' };",
          "    const payload = { sub: email, userId: String(userId), roles: roles, iat: nowSec, exp: nowSec + ttlSeconds, jti: 'postman-' + Math.random().toString(36).slice(2) };",
          "    const headerPart = encodeObject(header);",
          "    const payloadPart = encodeObject(payload);",
          "    const signature = base64Url(CryptoJS.HmacSHA256(headerPart + '.' + payloadPart, secret));",
          "    return headerPart + '.' + payloadPart + '.' + signature;",
          "  }",
          "  pm.collectionVariables.set('adminToken', makeJwt('admin.g10@sgitu.ma', '1', ['ROLE_ADMIN'], 3600));",
          "  pm.collectionVariables.set('operatorToken', makeJwt('operator.g10@sgitu.ma', '2', ['ROLE_OPERATOR'], 3600));",
          "  pm.collectionVariables.set('staffToken', makeJwt('staff.g10@sgitu.ma', '3', ['ROLE_STAFF'], 3600));",
          "  pm.collectionVariables.set('passengerToken', makeJwt('passenger.g10@sgitu.ma', '4', ['ROLE_PASSENGER'], 3600));",
          "  pm.collectionVariables.set('expiredToken', makeJwt('expired.g10@sgitu.ma', '5', ['ROLE_ADMIN'], -60));",
          "}",
          "",
          "if (!pm.collectionVariables.get('createdUserToken')) {",
          "  pm.collectionVariables.set('createdUserToken', pm.collectionVariables.get('passengerToken'));",
          "}"
        ]
      }
    }
  ],
  "variable": [
