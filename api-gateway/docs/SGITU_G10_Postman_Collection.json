{
  "info": {
    "name": "SGITU - G10 API Gateway & Securite",
    "description": "Collection adaptee : G3 emet les JWT et possede les utilisateurs. G10 valide le JWT, controle les roles et route vers G1-G9.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userToken", "value": "COLLER_JWT_G3_ROLE_USER" },
    { "key": "adminToken", "value": "COLLER_JWT_G3_ROLE_ADMIN" },
    { "key": "operatorToken", "value": "COLLER_JWT_G3_ROLE_OPERATOR" },
    { "key": "staffToken", "value": "COLLER_JWT_G3_ROLE_STAFF" }
  ],
  "item": [
    {
      "name": "Health G10",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Swagger G10",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/swagger-ui.html"
      }
    },
    {
      "name": "G3 Auth via G10 - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@sgitu.ma\",\n  \"password\": \"Password123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "401 - Protected route without JWT",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/payments/1"
      }
    },
    {
      "name": "403 - Update user roles with ROLE_USER",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "postman-403-admin-users" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roles\": [\"ROLE_OPERATOR\"]\n}"
        },
        "url": "{{baseUrl}}/api/users/1/roles"
      }
    },
    {
      "name": "G3 Users via G10",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "X-Correlation-Id", "value": "postman-admin-users" }
        ],
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "G1 Ticket via G10",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" },
          { "key": "X-Correlation-Id", "value": "postman-g1-ticket" }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/1"
      }
    },
    {
      "name": "G6 Payment via G10",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" },
          { "key": "X-Correlation-Id", "value": "postman-g6-payment" }
        ],
        "url": "{{baseUrl}}/api/payments/1"
      }
    },
    {
      "name": "G8 Ingestion tickets via G10",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "postman-g8-ingestion" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"ticketId\": \"TCK-1\",\n    \"userId\": \"1\",\n    \"timestamp\": \"2026-05-07T10:00:00Z\",\n    \"status\": \"validated\",\n    \"amount\": 6.0,\n    \"line\": \"L1\",\n    \"zone\": \"Centre\"\n  }\n]"
        },
        "url": "{{baseUrl}}/api/v1/ingestion/tickets"
      }
    },
    {
      "name": "G8 Analytics dashboard - Admin",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "X-Correlation-Id", "value": "postman-g8-dashboard" }
        ],
        "url": "{{baseUrl}}/api/v1/analytics/dashboard"
      }
    },
    {
      "name": "G8 Predict peak hours - Operator",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{operatorToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "postman-g8-predict" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"data\": [\n    { \"hour\": 8, \"validationCount\": 120 },\n    { \"hour\": 17, \"validationCount\": 180 },\n    { \"hour\": 18, \"validationCount\": 160 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/predict/peak-hours"
      }
    }
  ]
}
