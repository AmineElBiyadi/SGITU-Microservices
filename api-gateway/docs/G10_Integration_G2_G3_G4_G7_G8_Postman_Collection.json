    {
      "name": "01 - G3 Utilisateurs via G10",
      "item": [
        {
          "name": "01.1 - Register user public via G10",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "int-g3-register" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"ROLE_PASSENGER\",\n  \"profile\": {\n    \"firstName\": \"Postman\",\n    \"lastName\": \"Integration\",\n    \"phone\": \"+212600000000\",\n    \"address\": \"Casablanca\",\n    \"birthDate\": \"2000-01-01\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 ou 409 si deja cree', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) { const j = pm.response.json(); pm.collectionVariables.set('createdUserId', String(j.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "01.2 - Login G3 via G10 genere JWT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "int-g3-login" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 login ou 401 si user deja modifie/supprime', function () { pm.expect([200, 401, 403]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) { const j = pm.response.json(); pm.expect(j.token).to.exist; pm.collectionVariables.set('createdUserToken', j.token); }"
                ]
              }
            }
          ]
