            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{invalidToken}}" },
              { "key": "X-Correlation-Id", "value": "int-g3-invalid-jwt" }
            ],
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          },
          "event": [
