          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "X-Correlation-Id", "value": "net-g8-down" }], "url": "{{baseUrl}}/api/v1/analytics/dashboard" }
        }
      ]
    }
  ]
