{
  "info": {
    "name": "SGITU - G10 Multi-Group End-to-End Tests",
    "description": "Collection Postman de demonstration integree : Client -> G10 -> G3/G5/G8/G1/G6. Elle valide JWT/RBAC, propagation des headers, routage inter-groupes, ingestion analytics, notification et resilience 503.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const secret = pm.collectionVariables.get('jwtSecret') || 'SGITU_G3_JWT_SECRET_KEY_CHANGE_ME_IN_PRODUCTION_256BITS!!';",
          "const nowDate = new Date();",
          "pm.collectionVariables.set('isoNow', nowDate.toISOString());",
          "pm.collectionVariables.set('today', nowDate.toISOString().slice(0, 10));",
          "if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', 'e2e-' + Date.now()); }",
          "pm.collectionVariables.set('testEmail', 'e2e.' + pm.collectionVariables.get('runId') + '@sgitu.ma');",
          "pm.collectionVariables.set('g5NotificationId', 'notif-' + pm.collectionVariables.get('runId'));",
          "function b64url(input) { return CryptoJS.enc.Base64.stringify(input).replace(/=+$/,'').replace(/\\+/g,'-').replace(/\\//g,'_'); }",
          "function makeJwt(email, userId, roles, ttlSeconds) {",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const payload = { sub: email, userId: String(userId), roles: roles, iat: now, exp: now + ttlSeconds, jti: 'postman-' + Math.random().toString(36).slice(2) };",
          "  const h = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "  const p = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "  const s = b64url(CryptoJS.HmacSHA256(h + '.' + p, secret));",
          "  return h + '.' + p + '.' + s;",
          "}",
          "if (pm.collectionVariables.get('autoGenerateTokens') !== 'false') {",
          "  pm.collectionVariables.set('adminToken', makeJwt('admin.g10@sgitu.ma', '1', ['ROLE_ADMIN'], 3600));",
          "  pm.collectionVariables.set('operatorToken', makeJwt('operator.g10@sgitu.ma', '2', ['ROLE_OPERATOR'], 3600));",
          "  pm.collectionVariables.set('staffToken', makeJwt('staff.g10@sgitu.ma', '3', ['ROLE_STAFF'], 3600));",
          "  pm.collectionVariables.set('passengerToken', makeJwt('passenger.g10@sgitu.ma', '4', ['ROLE_PASSENGER'], 3600));",
          "  pm.collectionVariables.set('expiredToken', makeJwt('expired.g10@sgitu.ma', '5', ['ROLE_ADMIN'], -60));",
          "  pm.collectionVariables.set('invalidToken', pm.collectionVariables.get('adminToken') + 'invalid');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "jwtSecret", "value": "SGITU_G3_JWT_SECRET_KEY_CHANGE_ME_IN_PRODUCTION_256BITS!!", "type": "string" },
    { "key": "autoGenerateTokens", "value": "true", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "operatorToken", "value": "", "type": "string" },
    { "key": "staffToken", "value": "", "type": "string" },
    { "key": "passengerToken", "value": "", "type": "string" },
    { "key": "expiredToken", "value": "", "type": "string" },
    { "key": "invalidToken", "value": "", "type": "string" },
    { "key": "runId", "value": "", "type": "string" },
    { "key": "testEmail", "value": "", "type": "string" },
    { "key": "isoNow", "value": "", "type": "string" },
    { "key": "today", "value": "", "type": "string" },
    { "key": "g5NotificationId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "1", "type": "string" }
  ],
